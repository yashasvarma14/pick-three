# Copy this file to .streamlit/secrets.toml for local runs.
# On Streamlit Community Cloud, paste the same lines into
# App settings -> Secrets. Never commit the real secrets.toml.

OPENAI_API_KEY = "sk-..."
GOOGLE_MAPS_API_KEY = "..."        # Places API (New) + Routes API enabled
TICKETMASTER_API_KEY = "..."       # optional; Events is skipped without it

# Optional settings
OPENAI_MODEL = "gpt-6-luna"
MODEL_INPUT_PRICE_PER_1M = 0.10    # USD, used only for the cost estimate shown in the app
MODEL_OUTPUT_PRICE_PER_1M = 0.50
RUNS_PER_SESSION = 5               # searches per visitor per browser session
RUNS_PER_DAY = 150                 # searches per day across all visitors
APP_TIMEZONE = "America/Chicago"     # fallback if the city lookup fails

# Optional: live tracker (Google Sheet + Apps Script web app). Leave out to turn logging off.
# TRACKER_URL = "https://script.google.com/macros/s/.../exec"
# TRACKER_TOKEN = "the TOKEN value written in tracker_apps_script.gs"
